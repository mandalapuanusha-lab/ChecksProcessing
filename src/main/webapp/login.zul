<?page title="Check Processing System - Login"?>
<window apply="iispl.com.controller.LoginController" width="100%"
        style="min-height:100vh; background:linear-gradient(135deg,#1e3a8a 0%,#2563eb 100%);
               display:flex; align-items:center; justify-content:center;">

    <style>
        .login-card { background:white; border-radius:16px; padding:40px 48px;
                      box-shadow:0 20px 60px rgba(0,0,0,0.2); width:400px; margin:auto; }
        .login-title { font-size:24px; font-weight:700; color:#111827; margin-bottom:4px; }
        .login-sub   { font-size:14px; color:#6b7280; margin-bottom:28px; }
        .login-label { font-size:13px; font-weight:600; color:#374151; margin-bottom:6px; display:block; }
        .login-input { width:100%; padding:10px 14px; border:1.5px solid #d1d5db;
                       border-radius:8px; font-size:14px; outline:none; box-sizing:border-box; }
        .login-input:focus { border-color:#2563eb; }
        .login-btn   { width:100%; padding:11px; background:#2563eb; color:white;
                       border:none; border-radius:8px; font-size:15px; font-weight:600;
                       cursor:pointer; margin-top:8px; }
        .login-btn:hover { background:#1d4ed8; }
        .login-error { color:#dc2626; font-size:13px; margin-top:8px; padding:8px 12px;
                       background:#fef2f2; border-radius:6px; border:1px solid #fecaca; }
        .login-logo  { text-align:center; margin-bottom:24px; }
        .login-logo-icon { font-size:40px; }
        .login-logo-name { font-size:18px; font-weight:700; color:#2563eb; margin-top:4px; }
        .divider { height:1px; background:#e5e7eb; margin:20px 0; }
        .hint-text { font-size:12px; color:#9ca3af; text-align:center; margin-top:16px; }
    </style>

    <div style="display:flex; align-items:center; justify-content:center; min-height:100vh; padding:20px;">
        <div sclass="login-card">

            <!-- Logo -->
            <div sclass="login-logo">
                <div sclass="login-logo-icon">☑</div>
                <div sclass="login-logo-name">Check Processing System</div>
            </div>

            <div sclass="divider"/>

            <label value="Welcome back" sclass="login-title"/>
            <label value="Sign in to your account to continue" sclass="login-sub"/>

            <!-- Username -->
            <vlayout spacing="4px" style="margin-bottom:16px;">
                <label value="Username *" sclass="login-label"/>
                <textbox id="username" placeholder="Enter your username"
                         width="100%"
                         style="padding:10px 14px; border:1.5px solid #d1d5db;
                                border-radius:8px; font-size:14px; width:100%;"/>
            </vlayout>

            <!-- Password -->
            <vlayout spacing="4px" style="margin-bottom:20px;">
                <label value="Password *" sclass="login-label"/>
                <textbox id="password" type="password" placeholder="Enter your password"
                         width="100%"
                         style="padding:10px 14px; border:1.5px solid #d1d5db;
                                border-radius:8px; font-size:14px; width:100%;"/>
            </vlayout>

            <!-- Error message -->
            <label id="errorMsg" visible="false" sclass="login-error"/>

            <!-- Login Button -->
            <button id="loginBtn" label="Sign In →" width="100%"
                    style="padding:11px; background:#2563eb; color:white;
                           border:none; border-radius:8px; font-size:15px; font-weight:600;
                           cursor:pointer; margin-top:4px;"/>

            <label value="Demo credentials: admin / admin123"
                   sclass="hint-text"/>

        </div>
    </div>
</window>
