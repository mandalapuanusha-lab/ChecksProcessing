<window apply="iispl.com.controller.CheckEntryController" width="100%">

    <vlayout style="padding:30px; background:#f5f7fb;">

        <!-- Stepper -->
        <include src="/zul/components/stepper.zul"/>

        <!-- CARD -->
        <vlayout style="margin-top:20px; background:white; border-radius:10px; padding:25px; box-shadow:0 2px 8px rgba(0,0,0,0.1);">

            <label value="Enter Check Details"
                   style="font-size:20px; font-weight:bold; margin-bottom:15px;"/>

            <!-- FORM GRID -->
            <grid width="100%">
                <columns>
                    <column width="50%"/>
                    <column width="50%"/>
                </columns>

                <rows>

                    <!-- Check No + Date -->
                    <row>
                        <vlayout>
                            <label value="Check Number *"/>
                            <textbox id="checkNo" placeholder="Enter check number" width="95%"/>
                        </vlayout>

                        <vlayout>
                            <label value="Date *"/>
                            <datebox id="date" width="95%"/>
                        </vlayout>
                    </row>

                    <!-- Account -->
                    <row>
                        <vlayout>
                            <label value="Account Number *"/>
                            <textbox id="accountNo" placeholder="Enter account number" width="95%"/>
                        </vlayout>

                        <vlayout>
                            <label value="Account Name"/>
                            <textbox id="accountName" placeholder="Enter account holder name" width="95%"/>
                        </vlayout>
                    </row>

                    <!-- Amount -->
                    <row>
                        <vlayout>
                            <label value="Amount *"/>
                            <doublebox id="amount" placeholder="Enter amount" width="95%"/>
                        </vlayout>

                        <vlayout>
                            <label value="Amount in Words *"/>
                            <textbox id="amountInWords" placeholder="Enter amount in words" width="95%"/>
                        </vlayout>
                    </row>

                    <!-- IFSC + MICR -->
                    <row>
                        <vlayout>
                            <label value="IFSC Code *"/>
                            <textbox id="ifsc" placeholder="Enter IFSC code" width="95%"/>
                        </vlayout>

                        <vlayout>
                            <label value="MICR Code *"/>
                            <textbox id="micr" placeholder="Enter MICR code" width="95%"/>
                        </vlayout>
                    </row>

                    <!-- Bank -->
                    <row>
                        <vlayout>
                            <label value="Bank Name"/>
                            <textbox id="bankName" placeholder="Enter bank name" width="95%"/>
                        </vlayout>

                        <vlayout>
                            <label value="Branch Name"/>
                            <textbox id="branchName" placeholder="Enter branch name" width="95%"/>
                        </vlayout>
                    </row>

                </rows>
            </grid>

            <!-- BUTTON -->
            <hbox pack="end" style="margin-top:20px;">
                <button id="addBtn" label="+ Add Check"
                        style="background:#2563eb; color:white; border-radius:6px; padding:8px 18px;"/>
            </hbox>

        </vlayout>

        <!-- TABLE CARD -->
        <vlayout style="margin-top:20px; background:white; border-radius:10px; padding:20px; box-shadow:0 2px 8px rgba(0,0,0,0.1);">

            <label value="Checks Added"
                   style="font-size:18px; font-weight:bold; margin-bottom:10px;"/>

            <listbox id="checkList" width="100%">
                <listhead>
                    <listheader label="Check No"/>
                    <listheader label="Account No"/>
                    <listheader label="Amount"/>
                    <listheader label="Bank"/>
                    <listheader label="IFSC"/>
                    <listheader label="Status"/>
                </listhead>
            </listbox>

            <hbox pack="end" style="margin-top:15px;">
                <button label="Proceed to Validation →"
                        onClick='Executions.sendRedirect("/zul/validation.zul")'
                        style="background:#2563eb; color:white; border-radius:6px; padding:8px 18px;"/>
            </hbox>

        </vlayout>

    </vlayout>
</window>