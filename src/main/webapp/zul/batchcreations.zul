<?component name="stepper"
            macroURI="/zul/components/stepper.zul"
            class="iispl.com.component.Stepper"?>
<?component name="summarycard"
            macroURI="/zul/components/summarycard.zul"
            class="iispl.com.component.SummaryCard"?>
<?component name="datatable"
            macroURI="/zul/components/datatable.zul"
            class="iispl.com.component.DataTable"?>

<window apply="iispl.com.controller.BatchController" width="100%"
        style="background:#f8fafc; min-height:100vh; margin:0;">

    <!-- NAVBAR -->
    <div style="background:white;border-bottom:1px solid #e5e7eb;padding:0 32px;
                height:56px;display:flex;align-items:center;
                position:sticky;top:0;z-index:100;">
        <label value="✓" style="font-size:18px;font-weight:900;color:#2563eb;margin-right:8px;"/>
        <label value="Check Processing System"
               style="font-size:17px;font-weight:700;color:#1e293b;"/>
    </div>

    <vlayout style="padding:32px; max-width:1100px; margin:0 auto;">

        <!-- STEPPER -->
        <stepper activeStep="3"/>

        <!-- CARD -->
        <vlayout style="background:white;border-radius:12px;padding:28px;
                        box-shadow:0 1px 4px rgba(0,0,0,0.07);
                        border:1px solid #f1f5f9;margin-top:8px;">

            <!-- HEADER -->
            <hbox style="align-items:flex-start; margin-bottom:20px;">
                <vlayout hflex="1">
                    <label value="Batch Creation"
                           style="font-size:20px;font-weight:700;color:#1e293b;"/>
                    <label value="Select and approve valid checks for batch processing"
                           style="font-size:13px;color:#64748b;margin-top:4px;"/>
                </vlayout>
                <button label="← Back"
                        onClick='Executions.sendRedirect("/zul/validation.zul")'
                        style="background:#f1f5f9;color:#374151;border:1px solid #e5e7eb;
                               border-radius:8px;padding:9px 16px;font-size:14px;
                               font-weight:500;cursor:pointer;margin-left:auto;"/>
            </hbox>

            <!-- SUCCESS BOX -->
            <vlayout id="successBox" visible="false"
                     style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:12px;
                            padding:24px;margin-bottom:20px;">
                <label value="📦 Batch Created Successfully"
                       style="color:#16a34a;font-weight:700;font-size:16px;margin-bottom:12px;"/>
                <hbox spacing="40px" style="margin-bottom:16px;">
                    <vlayout>
                        <label value="Batch Number"
                               style="font-size:12px;color:#64748b;font-weight:500;"/>
                        <label id="batchNoLbl"
                               style="font-size:15px;font-weight:700;color:#1e293b;"/>
                    </vlayout>
                    <vlayout>
                        <label value="Total Checks"
                               style="font-size:12px;color:#64748b;font-weight:500;"/>
                        <label id="totalChecksLbl"
                               style="font-size:15px;font-weight:700;color:#1e293b;"/>
                    </vlayout>
                    <vlayout>
                        <label value="Total Amount"
                               style="font-size:12px;color:#64748b;font-weight:500;"/>
                        <label id="totalAmtLbl"
                               style="font-size:15px;font-weight:700;color:#1e293b;"/>
                    </vlayout>
                </hbox>
                <button label="Submit to NPCI Clearing →" id="npciBtn"
                        style="background:#2563eb;color:white;border:none;border-radius:8px;
                               padding:10px 20px;font-size:14px;font-weight:600;cursor:pointer;align-self:flex-end;"/>
            </vlayout>

            <!-- STAT CARDS -->
            <hlayout spacing="16px" style="margin-bottom:20px;">
                <summarycard id="validCountCard"    cardTitle="Valid Checks" cardValue="0"
                             cardColor="#e0ecff" labelColor="#2563eb"/>
                <summarycard id="selectedCountCard" cardTitle="Selected"     cardValue="0"
                             cardColor="#f3e8ff" labelColor="#9333ea"/>
                <summarycard id="approvedCountCard" cardTitle="Approved"     cardValue="0"
                             cardColor="#dcfce7" labelColor="#16a34a"/>
                <summarycard id="batchAmountCard"   cardTitle="Batch Amount" cardValue="₹0"
                             cardColor="#fff7ed" labelColor="#ea580c"/>
            </hlayout>

            <!-- Hidden labels for controller @Wire fallback -->
            <label id="validCount"    visible="false"/>
            <label id="selectedCount" visible="false"/>
            <label id="approvedCount" visible="false"/>
            <label id="batchAmount"   visible="false"/>

            <!-- ACTION BUTTONS -->
            <hbox spacing="10px" style="margin-bottom:20px;">
                <button label="Select All Valid" id="selectAllBtn"
                        style="background:#f1f5f9;color:#374151;border:1px solid #e5e7eb;
                               border-radius:8px;padding:9px 16px;font-size:14px;font-weight:500;cursor:pointer;"/>
                <button label="✓ Validate &amp; Approve Selected" id="approveBtn"
                        style="background:#16a34a;color:white;border:none;border-radius:8px;
                               padding:9px 18px;font-size:14px;font-weight:600;cursor:pointer;"/>
                <button label="📦 Create Batch" id="createBatchBtn"
                        style="background:#2563eb;color:white;border:none;border-radius:8px;
                               padding:9px 18px;font-size:14px;font-weight:600;cursor:pointer;"/>
            </hbox>

            <!-- REUSABLE DATATABLE (checkmark=true for multi-select) -->
            <datatable id="batchTable"
                       columns="SELECT,CHECK NO.,ACCOUNT NO.,AMOUNT,BANK,STATUS"
                       caption="Valid Checks"
                       emptyMessage="No valid checks available. Please run validation first."
                       showSearch="false"
                       checkmark="true"/>

        </vlayout>
    </vlayout>
</window>
